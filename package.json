{
  "name": "mixpanel-node",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run tsc && npm run test --workspaces --if-present",
    "tsc": "tsc --build",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.0.8",
    "oxlint": "^1.16.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
